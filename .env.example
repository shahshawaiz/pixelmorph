# Copy to .env (backend) / frontend/.env (frontend) and fill in. Never commit real values.
# --- backend ---
ENV=development
HF_TOKEN=                      # only for gated model downloads
OPENAI_API_KEY=                # optional; leave empty to skip LLM features
# --- frontend ---
NEXT_PUBLIC_API_URL=https://localhost:443
NEXT_PUBLIC_STRAPI_API_URL=http://localhost:1337
NEXT_PUBLIC_ASSET_PREFIX=
STRAPI_API_TOKEN=              # server-side only
NEXT_PUBLIC_ADMIN_USERNAME=    # see ROADMAP: move admin auth server-side
NEXT_PUBLIC_ADMIN_PASSWORD=
